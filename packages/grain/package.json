{
  "name": "@saltix/grain",
  "version": "0.1.0",
  "description": "The bridge between a grain and the Saltix wallet it runs in (Saltix 12-grains §5, docs/protocol/grains.md)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corvise/saltix-grains.git",
    "directory": "packages/grain"
  },
  "homepage": "https://github.com/corvise/saltix-grains#readme",
  "bugs": "https://github.com/corvise/saltix-grains/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-force-exit \"test/*.test.mjs\""
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
