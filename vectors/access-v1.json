  "rules": [
    "all Borsh, integers little-endian; µWORK for WORK amounts, slots for times",
    "actions after Registry (tag 1): OpenChannel tag 2 {exchange: [u8; 32], amount: u64}; TopUpChannel tag 3 {exchange, amount}; CloseChannel tag 4 {exchange}; StakeAccess tag 5 {amount: u64 SALT}; UnstakeAccess tag 6",
