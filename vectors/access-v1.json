    "allowance request: {exchange [32], payer [32], relay [32], client_key [32], amount u64, grant Option<{certificate, signature [64]}>, nonce [16], at u64}; client_key signs BLAKE3 derive_key(\"Salarium allowance request v1\", genesis hash ‖ request); the allowance takes the nonce, issued = the exchange's slot, expires = issued + 86 400",
    "voucher: client_key signs BLAKE3 derive_key(\"Salarium access voucher v1\", allowance id ‖ total as u64 big-endian)",
    "sponsor certificate: {sponsor, user_key [32], per_day u64, services u8, issued u64, expires u64}; sponsor = Ed25519 tag 0 [32] (the payer's own key) | P256 tag 1 [33] (a managed payer's device, SEC1 compressed); the sponsor signs m = BLAKE3 derive_key(\"Salarium sponsor certificate v1\", genesis hash ‖ certificate): Ed25519 over m, or ECDSA P-256 over SHA-256 of m as r ‖ s with a low s",
    "claim: Vec of {allowance, allowance signature [64], total u64, voucher [64], grant Option<{certificate, signature [64]}>}; id = BLAKE3 derive_key(\"Salarium access claim id v1\", genesis hash ‖ claim); fee = ⌈size × fee_per_byte / 100⌉ µWORK",
    "numbers are decimal strings: JSON loses precision above 2^53"
